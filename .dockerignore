packages/
*.nupkg
*.snupkg
.nuget/

# Publish profiles
*.pubxml
*.publishsettings

# User-specific files
launchSettings.json

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rtifacts/

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Logs
logs/
*.log
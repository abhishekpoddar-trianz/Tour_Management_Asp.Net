{
  "ConnectionStrings": {
    "dbconnection": "Server=${DB_SERVER};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD}"
  },
  "AppSettings": {
    "ChartImageHandler": "storage=file;timeout=20;dir=${CHART_TEMP_DIR:/tmp/charts};",
    "UploadPath": "${UPLOAD_PATH:/app/uploads}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management</h1>
    <p class="lead">Explore amazing tours and book your next adventure</p>
    <p>
        <a asp-page="/Tours/Index" class="btn btn-primary btn-lg">View Tours</a>
    </p>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Browse Tours</h5>
                <p class="card-text">Discover exciting tour packages to destinations around the world.</p>
                <a asp-page="/Tours/Index" class="btn btn-primary">Explore Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">My Bookings</h5>
                <p class="card-text">View and manage your tour bookings.</p>
                <a asp-page="/Bookings/MyBookings" class="btn btn-primary">View Bookings</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">User Account</h5>
                <p class="card-text">Manage your profile and account settings.</p>
                <a asp-page="/Account/Login" class="btn btn-primary">Login / Register</a>
            </div>
        </div>
    </div>
</div>

@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management System</h1>
    <p class="lead">Discover amazing tours and book your next adventure!</p>

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Browse Tours</h5>
                    <p class="card-text">Explore our collection of exciting tours to destinations around the world.</p>
                    <a href="/Tours" class="btn btn-primary">View Tours</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">My Bookings</h5>
                    <p class="card-text">View and manage your tour bookings all in one place.</p>
                    <a href="/Bookings/MyBookings" class="btn btn-primary">My Bookings</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Register</h5>
                    <p class="card-text">Create an account to start booking tours today!</p>
                    <a href="/Account/Register" class="btn btn-primary">Sign Up</a>
                </div>
            </div>
        </div>
    </div>
</div>

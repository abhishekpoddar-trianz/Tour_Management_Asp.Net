@page
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h1>Delete Tour</h1>

<h3 class="text-danger">Are you sure you want to delete this tour?</h3>

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@Model.Tour.TourName</h4>

                    <dl class="row">
                        <dt class="col-sm-3">Place:</dt>
                        <dd class="col-sm-9">@Model.Tour.Place</dd>

                        <dt class="col-sm-3">Days:</dt>
                        <dd class="col-sm-9">@Model.Tour.Days days</dd>

                        <dt class="col-sm-3">Price:</dt>
                        <dd class="col-sm-9">$@Model.Tour.Price.ToString("N2")</dd>

                        <dt class="col-sm-3">Locations:</dt>
                        <dd class="col-sm-9">@Model.Tour.Locations</dd>
                    </dl>

                    <form method="post">
                        <input type="hidden" asp-for="Tour.Id" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <a href="/Tours" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found.</div>
    <a href="/Tours" class="btn btn-secondary">Back to List</a>
}

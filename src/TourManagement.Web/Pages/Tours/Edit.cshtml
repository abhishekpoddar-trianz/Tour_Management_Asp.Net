@page
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-8">
            <form method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Tour.Id" />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Tour.TourName" class="form-label">Tour Name</label>
                    <input asp-for="Tour.TourName" class="form-control" required />
                    <span asp-validation-for="Tour.TourName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.Place" class="form-label">Place</label>
                    <input asp-for="Tour.Place" class="form-control" required />
                    <span asp-validation-for="Tour.Place" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.Days" class="form-label">Number of Days</label>
                    <input asp-for="Tour.Days" type="number" class="form-control" required />
                    <span asp-validation-for="Tour.Days" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.Price" class="form-label">Price</label>
                    <input asp-for="Tour.Price" type="number" step="0.01" class="form-control" required />
                    <span asp-validation-for="Tour.Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.Locations" class="form-label">Locations</label>
                    <input asp-for="Tour.Locations" class="form-control" required />
                    <span asp-validation-for="Tour.Locations" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.TourInfo" class="form-label">Tour Information</label>
                    <textarea asp-for="Tour.TourInfo" class="form-control" rows="5" required></textarea>
                    <span asp-validation-for="Tour.TourInfo" class="text-danger"></span>
                </div>

                @if (!string.IsNullOrEmpty(Model.Tour.PicturePath))
                {
                    <div class="mb-3">
                        <label class="form-label">Current Picture</label><br>
                        <img src="~/uploads/tours/@Model.Tour.PicturePath" alt="Current tour image" style="max-width: 200px;">
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="PictureFile" class="form-label">Update Picture (optional)</label>
                    <input asp-for="PictureFile" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="PictureFile" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a href="/Tours" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found.</div>
    <a href="/Tours" class="btn btn-secondary">Back to List</a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

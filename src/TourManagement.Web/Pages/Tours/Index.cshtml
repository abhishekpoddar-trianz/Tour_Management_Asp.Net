@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="row">
    <div class="col-md-12">
        <h1>Available Tours</h1>
        <a href="/Tours/Create" class="btn btn-success mb-3">Add New Tour</a>

        @if (Model.Tours != null && Model.Tours.Any())
        {
            <div class="row">
                @foreach (var tour in Model.Tours)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            @if (!string.IsNullOrEmpty(tour.PicturePath))
                            {
                                <img src="~/uploads/tours/@tour.PicturePath" class="card-img-top tour-image" alt="@tour.TourName">
                            }
                            else
                            {
                                <img src="https://via.placeholder.com/400x200?text=No+Image" class="card-img-top tour-image" alt="No image">
                            }
                            <div class="card-body">
                                <h5 class="card-title">@tour.TourName</h5>
                                <p class="card-text">
                                    <strong>Place:</strong> @tour.Place<br>
                                    <strong>Days:</strong> @tour.Days<br>
                                    <strong>Price:</strong> $@tour.Price.ToString("N2")<br>
                                    <strong>Locations:</strong> @tour.Locations
                                </p>
                                <p class="card-text">@(tour.TourInfo.Length > 100 ? tour.TourInfo.Substring(0, 100) + "..." : tour.TourInfo)</p>
                                <div class="btn-group" role="group">
                                    <a href="/Tours/Details?id=@tour.Id" class="btn btn-primary btn-sm">Details</a>
                                    <a href="/Tours/Edit?id=@tour.Id" class="btn btn-warning btn-sm">Edit</a>
                                    <a href="/Tours/Delete?id=@tour.Id" class="btn btn-danger btn-sm">Delete</a>
                                    <a href="/Bookings/Create?tourId=@tour.Id" class="btn btn-success btn-sm">Book Now</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">No tours available at the moment.</div>
        }
    </div>
</div>

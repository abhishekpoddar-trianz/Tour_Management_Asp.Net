@page
@model TourManagement.Web.Pages.Tours.CreateModel
@{
    ViewData["Title"] = "Create Tour";
}

<h1>Create New Tour</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="TourName" class="form-label">Tour Name</label>
                <input asp-for="TourName" class="form-control" required />
                <span asp-validation-for="TourName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Place" class="form-label">Place</label>
                <input asp-for="Place" class="form-control" required />
                <span asp-validation-for="Place" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Days" class="form-label">Number of Days</label>
                <input asp-for="Days" type="number" class="form-control" required />
                <span asp-validation-for="Days" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">Price</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Locations" class="form-label">Locations</label>
                <input asp-for="Locations" class="form-control" required />
                <span asp-validation-for="Locations" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TourInfo" class="form-label">Tour Information</label>
                <textarea asp-for="TourInfo" class="form-control" rows="5" required></textarea>
                <span asp-validation-for="TourInfo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PictureFile" class="form-label">Tour Picture</label>
                <input asp-for="PictureFile" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="PictureFile" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Create Tour</button>
                <a href="/Tours" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

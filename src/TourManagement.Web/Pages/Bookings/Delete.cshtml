@page
@model TourManagement.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Delete Booking";
}

<h1>Delete Booking</h1>

<h3 class="text-danger">Are you sure you want to delete this booking?</h3>

@if (Model.Booking != null)
{
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Booking #@Model.Booking.Id</h4>

                    <dl class="row">
                        <dt class="col-sm-3">Tour Name:</dt>
                        <dd class="col-sm-9">@Model.Booking.TourName</dd>

                        <dt class="col-sm-3">Place:</dt>
                        <dd class="col-sm-9">@Model.Booking.Place</dd>

                        <dt class="col-sm-3">Email:</dt>
                        <dd class="col-sm-9">@Model.Booking.Email</dd>

                        <dt class="col-sm-3">First Name:</dt>
                        <dd class="col-sm-9">@Model.Booking.FirstName</dd>
                    </dl>

                    <form method="post">
                        <input type="hidden" asp-for="Booking.Id" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <a href="/Bookings" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Booking not found.</div>
    <a href="/Bookings" class="btn btn-secondary">Back to List</a>
}

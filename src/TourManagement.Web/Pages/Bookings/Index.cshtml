@page
@model TourManagement.Web.Pages.Bookings.IndexModel
@{
    ViewData["Title"] = "All Bookings";
}

<h1>All Bookings</h1>

@if (Model.Bookings != null && Model.Bookings.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Tour Name</th>
                    <th>Place</th>
                    <th>Email</th>
                    <th>First Name</th>
                    <th>Booking Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.Id</td>
                        <td>@booking.TourName</td>
                        <td>@booking.Place</td>
                        <td>@booking.Email</td>
                        <td>@booking.FirstName</td>
                        <td>@booking.BookingDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <a href="/Bookings/Details?id=@booking.Id" class="btn btn-primary btn-sm">Details</a>
                            <a href="/Bookings/Delete?id=@booking.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">No bookings found.</div>
}

<a href="/Tours" class="btn btn-secondary">Back to Tours</a>
